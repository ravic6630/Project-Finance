# Copy to .env.production and fill in. All optional except JWT_SECRET (recommended in prod).
# docker-compose loads this file as the container's environment.

# Strongly recommended in production (else one is auto-generated on the data volume).
JWT_SECRET=

# Admin accounts (comma-separated) — can manage/delete users.
ADMIN_EMAILS=ralathuru@gmail.com

# --- Daily summary email (optional) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM=Sampada <no-reply@vyomarafarms.com>
DIGEST_HOUR=8

# --- Broker connect (optional) — redirect base must be your public URL ---
BROKER_REDIRECT_BASE=https://vyomarafarms.com
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
UPSTOX_API_KEY=
UPSTOX_API_SECRET=

# --- Payments: Razorpay (optional, use TEST keys first) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PLAN_ID=
RAZORPAY_WEBHOOK_SECRET=
