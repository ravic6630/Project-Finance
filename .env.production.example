# Copy to .env.production and fill in. All optional except JWT_SECRET (recommended in prod).
# docker-compose loads this file as the container's environment.

# Strongly recommended in production (keeps everyone logged in across restarts).
JWT_SECRET=

# --- Persistent database (Turso, free cloud SQLite) ---
# Without these the app uses a local file that RESETS on every restart/redeploy.
# Create a free DB at turso.tech, then paste its URL + an auth token here.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Admin accounts (comma-separated) — can manage/delete users.
ADMIN_EMAILS=ralathuru@gmail.com

# --- Daily summary email (optional) ---
# RECOMMENDED on Render's free tier (and any host that blocks SMTP ports): send
# via Brevo's HTTP API instead of SMTP. Sign up free at brevo.com, verify your
# sender address, create an API key (SMTP & API -> API Keys), and set it here.
# EMAIL_FROM's address must be a verified Brevo sender.
BREVO_API_KEY=
EMAIL_FROM=Sampada <no-reply@vyomarafarms.com>
DIGEST_HOUR=8

# Alternative to BREVO_API_KEY: classic SMTP (works locally / on paid hosts that
# allow outbound SMTP; Render's FREE tier blocks ports 25/465/587).
# Gmail example: HOST=smtp.gmail.com, PORT=587, USER=you@gmail.com,
# PASS=<16-char Google App Password>, SECURE=false, FROM=Sampada <you@gmail.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# Daily digest trigger for an external scheduler (needed on hosts that sleep,
# e.g. Render free tier). Set a long random string, then have a free cron
# service GET https://<your-app>/api/cron/digests?key=<this value> daily.
CRON_SECRET=

# --- Broker connect (optional) — redirect base must be your public URL ---
BROKER_REDIRECT_BASE=https://vyomarafarms.com
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
# Angel One SmartAPI (free). Create an app at smartapi.angelbroking.com and set its
# redirect URL to https://<your-domain>/broker/angelone/callback.
ANGELONE_API_KEY=
ANGELONE_API_SECRET=

# --- Payments ---
# India (base currency INR) checks out with Razorpay (UPI + card). Create a
# monthly plan + an annual plan (annual = ~10% off) in the Razorpay dashboard.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PLAN_ID=
RAZORPAY_PLAN_ID_ANNUAL=
RAZORPAY_WEBHOOK_SECRET=

# Everyone else checks out with Stripe Checkout (Apple Pay / Google Pay / card,
# auto-renewing). Prices are created on the fly from web/server config — you only
# need the secret key + the webhook signing secret (whsec_...). Point the Stripe
# webhook at https://<your-app>/api/billing/stripe-webhook (events:
# checkout.session.completed, invoice.paid, customer.subscription.deleted).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
