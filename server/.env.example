# Copy to .env to override defaults. All values are optional.
# Port the API listens on (default 4000)
PORT=4000
# Secret used to sign login tokens. If unset, the server generates and
# persists one automatically in server/data/.jwt_secret on first boot.
JWT_SECRET=
# Comma-separated emails that become admins automatically on signup (optional).
ADMIN_EMAILS=

# --- Broker connect (optional) ---
# Create a free developer app at the broker, then paste keys here.
# Set the broker app's redirect URL to: http://localhost:3000/broker/<broker>/callback
BROKER_REDIRECT_BASE=http://localhost:3000
# Zerodha Kite Connect (https://developers.kite.trade)
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
# Upstox (https://upstox.com/developer/apps)
UPSTOX_API_KEY=
UPSTOX_API_SECRET=

# --- Payments: Razorpay (optional, use TEST keys first) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PLAN_ID=
RAZORPAY_WEBHOOK_SECRET=

# --- Daily summary email (optional) ---
# SMTP works with Gmail (app password), Brevo, Amazon SES, etc.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM=Sampada <no-reply@yourdomain.com>
# Hour (IST, 0-23) to send the daily digest. Default 8 (8am).
DIGEST_HOUR=8
